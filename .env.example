# Copy to .env at the repo root. Every value below is the default —
# the app runs with this file as-is (fake gateway, deterministic fake LLM),
# no Razorpay account or Anthropic key required.
# Loaded by backend/app/config.py (pydantic-settings, case-insensitive).

# --- Gateway seam ---------------------------------------------------------
# "fake"     : in-process deterministic stub (default, no credentials)
# "razorpay" : real Razorpay test-mode APIs (requires the keys below)
GATEWAY_BACKEND=fake

# --- Case lifecycle timing --------------------------------------------
# How long an OPEN case waits for an outcome before the scheduled sweep
# treats silence as a reassessment trigger (ADR-0005), and how often the
# sweep runs. Seconds.
RESPONSE_WINDOW_SECONDS=3600
SWEEP_INTERVAL_SECONDS=300

# --- Database ----------------------------------------------------------
# SQLite path is relative to the process working directory (run from backend/).
DATABASE_URL=sqlite:///./recovery.db

# --- One-port / hosted demo (ADR-0015) -------------------------------
# All four defaults below are for the local two-terminal dev setup. The
# Dockerfile flips them for the single-container hosted demo; you only set
# them by hand for an unusual local run.
#
# STATIC_DIR : when this dir exists, the backend also serves it as the SPA
#              at "/", so one process answers UI + API. Default is the local
#              `npm run build` output. Leave unset for a backend-only run.
# STATIC_DIR=../frontend/dist
#
# DEV_CORS      : add the localhost:5173 CORS middleware. Needed only for the
#                 two-origin `npm run dev` setup; the container sets it false.
DEV_CORS=true
# SWEEP_ENABLED : run ADR-0005's in-process reassessment sweep. The hosted
#                 replay sets it false.
SWEEP_ENABLED=true
# DEMO_READONLY : reject the human-action write endpoints with 403 and tell
#                 the SPA (via /config) to hide their controls. Hosted only.
DEMO_READONLY=false

# --- Anthropic (optional) --------------------------------------------
# Unset -> llm.py falls back to the deterministic FakeLLMClient.
# Set   -> the three bounded LLM roles call real Claude.
ANTHROPIC_API_KEY=

# --- Razorpay test mode (only needed when GATEWAY_BACKEND=razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_URL=
