# Copy to .env at the repo root. Every value below is the default —
# the app runs with this file as-is (fake gateway, deterministic fake LLM),
# no Razorpay account or Anthropic key required.
# Loaded by backend/app/config.py (pydantic-settings, case-insensitive).

# --- Gateway seam ---------------------------------------------------------
# "fake"     : in-process deterministic stub (default, no credentials)
# "razorpay" : real Razorpay test-mode APIs (requires the keys below)
GATEWAY_BACKEND=fake

# --- Case lifecycle timing --------------------------------------------
# How long an OPEN case waits for an outcome before the scheduled sweep
# treats silence as a reassessment trigger (ADR-0005), and how often the
# sweep runs. Seconds.
RESPONSE_WINDOW_SECONDS=3600
SWEEP_INTERVAL_SECONDS=300

# --- Database ----------------------------------------------------------
# SQLite path is relative to the process working directory (run from backend/).
DATABASE_URL=sqlite:///./recovery.db

# --- Anthropic (optional) --------------------------------------------
# Unset -> llm.py falls back to the deterministic FakeLLMClient.
# Set   -> the three bounded LLM roles call real Claude.
ANTHROPIC_API_KEY=

# --- Razorpay test mode (only needed when GATEWAY_BACKEND=razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_URL=
